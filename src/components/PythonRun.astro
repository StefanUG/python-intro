---
// Renders a python.run block with CodeMirror editor + Skulpt execution.
// Skulpt is loaded globally via head config in astro.config.mjs.
interface Props {
  code: string
  /** e.g. "codingpirates-maze" (uses the pinned defaultVersion) or "codingpirates-maze:0.4.1" (explicit override) - fetches and registers the package's Skulpt-compatible sources before running. */
  requires?: string
}
const { code, requires } = Astro.props
---

<div class="python-run not-content" data-python-run data-original={code} data-requires={requires}>
  <div class="python-run-header">
    <span class="python-run-label">▶ Python</span>
    <button class="python-run-btn" data-action="run">Kør kode</button>
    <button class="python-run-btn" data-action="reset">Nulstil</button>
    <button class="python-run-btn python-run-fs-btn" data-action="fullscreen" title="Fuld skærm">⛶</button>
  </div>
  <div class="python-run-editor" data-role="editor"></div>
  <div class="python-run-resize-handle" aria-hidden="true"></div>
  <div class="python-run-turtle" data-role="turtle"></div>
  <pre class="python-run-stdout" data-role="stdout" hidden></pre>
</div>

<script>
  import { EditorView, lineNumbers, highlightActiveLineGutter, highlightSpecialChars, drawSelection, dropCursor, rectangularSelection, crosshairCursor, highlightActiveLine, keymap } from '@codemirror/view'
  import { EditorState } from '@codemirror/state'
  import { foldGutter, indentOnInput, syntaxHighlighting, defaultHighlightStyle, bracketMatching, foldKeymap } from '@codemirror/language'
  import { history, defaultKeymap, historyKeymap, indentWithTab } from '@codemirror/commands'
  import { highlightSelectionMatches, searchKeymap } from '@codemirror/search'
  import { closeBrackets, closeBracketsKeymap, autocompletion, completionKeymap, completeFromList, snippetCompletion, ifNotIn } from '@codemirror/autocomplete'
  import { python, localCompletionSource } from '@codemirror/lang-python'
  import { oneDark } from '@codemirror/theme-one-dark'

  // Turtle-module functions used throughout the lessons – suggested alongside
  // the student's own variables/functions since `turtle` isn't statically analyzed.
  const dontCompleteIn = ['String', 'FormatString', 'Comment', 'PropertyName']
  const turtleCompletionSource = ifNotIn(dontCompleteIn, completeFromList([
    snippetCompletion('forward(${distance})', { label: 'forward', type: 'function', detail: '(distance)' }),
    // snippetCompletion('fd(${distance})', { label: 'fd', type: 'function', detail: '(distance)' }),
    snippetCompletion('backward(${distance})', { label: 'backward', type: 'function', detail: '(distance)' }),
    // snippetCompletion('bk(${distance})', { label: 'bk', type: 'function', detail: '(distance)' }),
    snippetCompletion('right(${angle})', { label: 'right', type: 'function', detail: '(angle)' }),
    // snippetCompletion('rt(${angle})', { label: 'rt', type: 'function', detail: '(angle)' }),
    snippetCompletion('left(${angle})', { label: 'left', type: 'function', detail: '(angle)' }),
    // snippetCompletion('lt(${angle})', { label: 'lt', type: 'function', detail: '(angle)' }),
    snippetCompletion('goto(${x}, ${y})', { label: 'goto', type: 'function', detail: '(x, y)' }),
    // snippetCompletion('setheading(${angle})', { label: 'setheading', type: 'function', detail: '(angle)' }),
    snippetCompletion('circle(${radius})', { label: 'circle', type: 'function', detail: '(radius)' }),
    // snippetCompletion('dot(${size})', { label: 'dot', type: 'function', detail: '(size)' }),
    snippetCompletion('speed(${speed})', { label: 'speed', type: 'function', detail: '(speed)' }),
    { label: 'penup', type: 'function', apply: 'penup()' },
    { label: 'pendown', type: 'function', apply: 'pendown()' },
    //snippetCompletion('pensize(${width})', { label: 'pensize', type: 'function', detail: '(width)' }),
    //snippetCompletion('pencolor(${color})', { label: 'pencolor', type: 'function', detail: '(color)' }),
    //snippetCompletion('fillcolor(${color})', { label: 'fillcolor', type: 'function', detail: '(color)' }),
    snippetCompletion('color(${color})', { label: 'color', type: 'function', detail: '(color)' }),
    //{ label: 'begin_fill', type: 'function', apply: 'begin_fill()' },
    //{ label: 'end_fill', type: 'function', apply: 'end_fill()' },
    //{ label: 'clear', type: 'function', apply: 'clear()' },
    //{ label: 'reset', type: 'function', apply: 'reset()' },
    { label: 'hideturtle', type: 'function', apply: 'hideturtle()' },
    { label: 'showturtle', type: 'function', apply: 'showturtle()' },
    snippetCompletion('write(${text})', { label: 'write', type: 'function', detail: '(text)' }),
    snippetCompletion('bgcolor(${color})', { label: 'bgcolor', type: 'function', detail: '(color)' }),
    //snippetCompletion('screensize(${width}, ${height})', { label: 'screensize', type: 'function', detail: '(width, height)' }),
  ]))

  // Same as codemirror's basicSetup, but autocompletion is restricted to locally
  // defined variables/functions and turtle-module functions – no other Python
  // keyword/builtin suggestions.
  const editorSetup = [
    lineNumbers(),
    highlightActiveLineGutter(),
    highlightSpecialChars(),
    history(),
    foldGutter(),
    drawSelection(),
    dropCursor(),
    EditorState.allowMultipleSelections.of(true),
    indentOnInput(),
    syntaxHighlighting(defaultHighlightStyle, { fallback: true }),
    bracketMatching(),
    closeBrackets(),
    rectangularSelection(),
    crosshairCursor(),
    highlightActiveLine(),
    highlightSelectionMatches(),
    autocompletion({ override: [localCompletionSource, turtleCompletionSource] }),
    keymap.of([
      ...closeBracketsKeymap,
      ...defaultKeymap,
      ...searchKeymap,
      ...historyKeymap,
      ...foldKeymap,
      ...completionKeymap,
    ]),
  ]

  // djb2 hash – produces a stable short key from the original source code
  function hash(s: string): string {
    let h = 5381
    for (let i = 0; i < s.length; i++) h = (((h << 5) + h) ^ s.charCodeAt(i)) >>> 0
    return h.toString(36)
  }

  // Skulpt ships no `enum` module at all (ModuleNotFoundError) - minimal polyfill covering
  // what codingpirates-maze needs: members, .name/.value, equality, iteration, _missing_.
  const ENUM_POLYFILL = `
class EnumMeta(type):
    def __new__(mcs, name, bases, namespace):
        member_names = []
        for key in list(namespace.keys()):
            if key.startswith('_'):
                continue
            value = namespace[key]
            if callable(value) or isinstance(value, (staticmethod, classmethod, property)):
                continue
            member_names.append(key)

        cls = type.__new__(mcs, name, bases, namespace)
        cls._member_map_ = {}
        cls._member_list_ = []
        for key in member_names:
            member = object.__new__(cls)
            member._name_ = key
            member._value_ = namespace[key]
            setattr(cls, key, member)
            cls._member_map_[key] = member
            cls._member_list_.append(member)
        return cls

    def __call__(cls, value):
        for member in cls._member_list_:
            if member._value_ == value:
                return member
        missing = getattr(cls, '_missing_', None)
        if missing is not None:
            result = missing(value)
            if result is not None:
                return result
        raise ValueError(str(value) + ' is not a valid ' + cls.__name__)

    def __iter__(cls):
        return iter(cls._member_list_)

    def __len__(cls):
        return len(cls._member_list_)


class Enum(metaclass=EnumMeta):
    @property
    def name(self):
        return self._name_

    @property
    def value(self):
        return self._value_

    def __eq__(self, other):
        return self is other

    def __ne__(self, other):
        return self is not other

    def __hash__(self):
        return id(self)

    def __repr__(self):
        return '<' + type(self).__name__ + '.' + self._name_ + ': ' + repr(self._value_) + '>'

    def __str__(self):
        return type(self).__name__ + '.' + self._name_
`

  // Registers stdlib gaps Skulpt has no module for at all - safe/cheap to do unconditionally.
  function ensurePolyfills(Sk: any) {
    Sk.builtinFiles = Sk.builtinFiles || { files: {} }
    if (!Sk.builtinFiles.files['src/lib/enum.py']) {
      Sk.builtinFiles.files['src/lib/enum.py'] = ENUM_POLYFILL
    }
  }

  function debounce(fn: () => void, ms: number) {
    let t: ReturnType<typeof setTimeout>
    return () => { clearTimeout(t); t = setTimeout(fn, ms) }
  }

  // Wrap localStorage so private-browsing / storage-full errors don't crash the page
  const ls = {
    get: (k: string) => { try { return localStorage.getItem(k) } catch { return null } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v) } catch {} },
    del: (k: string) => { try { localStorage.removeItem(k) } catch {} },
  }

  // Maps a PyPI package name to its GitHub repo + the Skulpt-importable module files it ships.
  // Only pure-Python packages with a Skulpt-compatible resources layer (see codingpirates-maze
  // 0.4.0+) belong here - add new entries as more libraries get Skulpt support.
  // `defaultVersion` is used whenever an MDX page's `requires=` attribute omits a version
  // (e.g. `requires="codingpirates-maze"`) - bump it here to upgrade every lesson at once.
  const PACKAGE_REGISTRY: Record<string, { importName: string; githubRepo: string; modules: string[]; defaultVersion: string }> = {
    'codingpirates-maze': {
      importName: 'maze',
      githubRepo: 'StefanUG/codingpirates-maze',
      defaultVersion: '0.4.3',
      modules: [
        '__init__.py', 'bee.py', 'beeshape.py', 'birds.py', 'collector.py',
        'farmer.py', 'harvester.py', 'maze.py', 'puzzle.py', 'pvz.py',
        'resources.py', 'screencapture.py', 'zombieshape.py',
      ],
    },
  }

  // Fetches + registers a `requires="pypiName"` or `requires="pypiName:version"` package's
  // sources into Skulpt exactly once per page. An omitted version falls back to the
  // package's `defaultVersion` above, so lessons don't need to hardcode/repeat it.
  const loadedRequires = new Map<string, Promise<void>>()
  function ensureRequires(Sk: any, requiresAttr: string | undefined) {
    if (!requiresAttr) return Promise.resolve()
    const [pypiName, explicitVersion] = requiresAttr.split(':')
    const pkg = PACKAGE_REGISTRY[pypiName]
    if (!pkg) return Promise.reject(new Error(`Ukendt pakke: ${pypiName}`))
    const version = explicitVersion || pkg.defaultVersion

    const cacheKey = `${pypiName}@${version}`
    let promise = loadedRequires.get(cacheKey)
    if (!promise) {
      const baseUrl = `https://cdn.jsdelivr.net/gh/${pkg.githubRepo}@v${version}/src/${pkg.importName}`
      promise = Promise.all(
        pkg.modules.map(file =>
          fetch(`${baseUrl}/${file}`).then(res => {
            if (!res.ok) throw new Error(`Kunne ikke hente ${file} (${res.status})`)
            return res.text()
          }).then(source => {
            Sk.builtinFiles.files[`src/lib/${pkg.importName}/${file}`] = source
          })
        )
      ).then(() => {})
      loadedRequires.set(cacheKey, promise)
    }
    return promise
  }

  document.querySelectorAll<HTMLElement>('[data-python-run]').forEach(block => {
    if (block.dataset.init) return
    block.dataset.init = '1'

    const originalCode = block.dataset.original ?? ''
    const storageKey = `python-run-${hash(originalCode)}`
    const editorDiv = block.querySelector<HTMLElement>('[data-role="editor"]')!
    const turtleDiv = block.querySelector<HTMLElement>('[data-role="turtle"]')!
    const stdout = block.querySelector<HTMLElement>('[data-role="stdout"]')!

    const save = debounce(() => ls.set(storageKey, view.state.doc.toString()), 500)

    const view = new EditorView({
      state: EditorState.create({
        doc: ls.get(storageKey) ?? originalCode,
        extensions: [
          editorSetup,
          python(),
          oneDark,
          keymap.of([indentWithTab]),
          EditorView.updateListener.of(u => { if (u.docChanged) save() }),
        ],
      }),
      parent: editorDiv,
    })

    // If this editor was inside a hidden Solution block, refresh layout when revealed
    document.addEventListener('solutions-changed', () => view.requestMeasure())

    const handle = block.querySelector<HTMLElement>('.python-run-resize-handle')!

    handle.addEventListener('mousedown', e => { e.preventDefault(); startResize(e.clientY) })
    handle.addEventListener('touchstart', e => { e.preventDefault(); startResize(e.touches[0].clientY) }, { passive: false })

    function startResize(startY: number) {
      const scroller = editorDiv.querySelector<HTMLElement>('.cm-scroller')!
      const startHeight = scroller.offsetHeight
      document.body.style.cursor = 'ns-resize'

      const onMove = (clientY: number) => {
        const h = Math.max(60, startHeight + (clientY - startY))
        scroller.style.maxHeight = h + 'px'
        scroller.style.height = h + 'px'
        view.requestMeasure()
      }

      const cleanup = () => {
        document.body.style.cursor = ''
        document.removeEventListener('mousemove', onMouseMove)
        document.removeEventListener('mouseup', cleanup)
        document.removeEventListener('touchmove', onTouchMove)
        document.removeEventListener('touchend', cleanup)
      }
      const onMouseMove = (e: MouseEvent) => onMove(e.clientY)
      const onTouchMove = (e: TouchEvent) => onMove(e.touches[0].clientY)

      document.addEventListener('mousemove', onMouseMove)
      document.addEventListener('mouseup', cleanup)
      document.addEventListener('touchmove', onTouchMove, { passive: false })
      document.addEventListener('touchend', cleanup)
    }

    const fsBtn = block.querySelector<HTMLElement>('[data-action="fullscreen"]')!

    fsBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        block.requestFullscreen()
      } else {
        document.exitFullscreen()
      }
    })

    // Escape is handled automatically by the browser; sync button label on any change
    block.addEventListener('fullscreenchange', () => {
      const isFs = document.fullscreenElement === block
      fsBtn.textContent = isFs ? '\u2715' : '\u26f6'
      fsBtn.title = isFs ? 'Luk fuld sk\u00e6rm (Esc)' : 'Fuld sk\u00e6rm'
      if (isFs) {
        const scroller = editorDiv.querySelector<HTMLElement>('.cm-scroller')
        if (scroller) { scroller.style.height = ''; scroller.style.maxHeight = '' }
      }
      view.requestMeasure()
    })

    block.querySelector('[data-action="run"]')!.addEventListener('click', async () => {
      const Sk = (window as any).Sk
      if (!Sk) return alert('Skulpt er ikke indlæst endnu – prøv igen om et øjeblik.')

      turtleDiv.innerHTML = ''
      stdout.textContent = ''
      stdout.hidden = true

      try {
        ensurePolyfills(Sk)
        await ensureRequires(Sk, block.dataset.requires)
      } catch (err) {
        const span = document.createElement('span')
        span.className = 'python-run-error-text'
        span.textContent = String(err)
        stdout.appendChild(span)
        stdout.hidden = false
        return
      }

      Sk.configure({
        output: (text: string) => { stdout.textContent += text; stdout.hidden = false },
        read: (x: string) => {
          if (Sk.builtinFiles?.files[x] == null) throw `File not found: '${x}'`
          return Sk.builtinFiles.files[x]
        },
        // Sk.configure defaults this to a nonexistent "localhost:8080" dev proxy otherwise,
        // silently breaking any cross-origin image (e.g. our CDN-hosted assets) - the CDNs we
        // use already serve images with CORS, so a passthrough is all that's needed.
        imageProxy: (url: string) => url,
      })
      Sk.TurtleGraphics = {
        target: turtleDiv,
        width: 400,
        height: 400,
        // register_shape()/bgpic() resolve a "name" through this before fetching an Image;
        // Maze.shapefile() already returns a full CDN URL, so a passthrough is all we need
        // (defaults to `{}`, which silently no-ops and leaves shapes/backgrounds unset).
        assets: (name: string) => name,
      }

      Sk.misceval.asyncToPromise(() =>
        Sk.importMainWithBody('<stdin>', false, view.state.doc.toString(), true)
      ).catch((err: any) => {
        const span = document.createElement('span')
        span.className = 'python-run-error-text'
        span.textContent = String(err)
        stdout.appendChild(span)
        stdout.hidden = false
      })
    })

    block.querySelector('[data-action="reset"]')!.addEventListener('click', () => {
      if (!confirm('Nulstil koden til udgangspunktet? Dine ændringer går tabt.')) return
      ls.del(storageKey)
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: originalCode } })
      turtleDiv.innerHTML = ''
      stdout.textContent = ''
      stdout.hidden = true
    })
  })
</script>
